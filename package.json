{
  "name": "family-calendar",
  "version": "0.8.0",
  "description": "Always-on family calendar & reminders display for Raspberry Pi",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "auth:google": "node scripts/google-auth.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser",
    "test:security": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "10.1.3",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "googleapis": "^173.0.0",
    "ical.js": "^2.2.1",
    "node-cron": "^4.6.0",
    "tsdav": "^2.3.4",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.0"
  }
}
